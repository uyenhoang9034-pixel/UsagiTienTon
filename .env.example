DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
OWNER_IDS=
PREFIX=!
NODE_ENV=production
LOG_LEVEL=info
LOG_TO_FILE=false
PORT=3001

# Existing server values retained. Use token/CLIENT_ID of the NEW bot.
GAME_ROLE_NOTIFICATION_CHANNEL_ID=1547128793737728111
CULTIVATION_CHANNEL_ID=1547233544412205066

# Set DATABASE_URL on hosting, or the POSTGRES fields for a local database.
# Docker Compose supplies host/user/database; set password below.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=usagitienton
POSTGRES_USER=usagitienton
POSTGRES_PASSWORD=
POSTGRES_SSL=false
AUTO_MIGRATE=true
ALLOW_MEMORY_DATABASE=false

# Lavalink v4 + YouTube plugin. Docker Compose supplies host.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_SEARCH_PLATFORM=ytmsearch
LAVALINK_REST_VERSION=v4
# Optional override: LAVALINK_NODES JSON array or LAVALINK_NODES_FILE path.
